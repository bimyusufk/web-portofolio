# ---------------------------------------------------------------------------
# Sanity — wajib. Nilai didapat setelah menjalankan `npx sanity init`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Versi API Sanity. Biarkan kosong untuk memakai bawaan (2025-01-01).
NEXT_PUBLIC_SANITY_API_VERSION=

# ---------------------------------------------------------------------------
# Token — hanya dipakai di server. Jangan pernah beri awalan NEXT_PUBLIC_.
# Dibuat di sanity.io/manage > API > Tokens.
# ---------------------------------------------------------------------------

# Token tulis (peran Editor), khusus untuk skrip migrasi sekali jalan.
SANITY_API_WRITE_TOKEN=

# Token baca (peran Viewer), opsional — untuk pratinjau draf.
SANITY_API_READ_TOKEN=

# Rahasia webhook revalidasi. Isi dengan string acak panjang, lalu masukkan
# nilai yang sama pada webhook di sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Situs
# ---------------------------------------------------------------------------
# URL kanonis produksi, dipakai untuk metadata, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
