generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubId      String?   @unique
  role          String    @default("OWNER")
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  revisions Revision[] @relation("RevisionAuthor")
  projects  Project[]  @relation("ProjectCreator")
  research  Research[] @relation("ResearchCreator")
  media     Media[]    @relation("Uploader")
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String
  mdxContent  String
  role        String?
  tech        String
  type        String?
  demoUrl     String?
  repoUrl     String?
  images      String
  thumbnailId String?
  featured    Boolean       @default(false)
  status      String        @default("DRAFT")
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy   User    @relation("ProjectCreator", fields: [createdById], references: [id])
  createdById String
  thumbnail   Media?  @relation("ProjectThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  gallery     Media[] @relation("ProjectGallery")

  revisions Revision[]
}

model Research {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  authors     String
  venue       String?
  year        Int?
  doi         String?
  pdfUrl      String?
  summary     String
  mdxContent  String
  keywords    String
  thumbnailId String?
  status      String        @default("DRAFT")
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy   User    @relation("ResearchCreator", fields: [createdById], references: [id])
  createdById String
  thumbnail   Media?  @relation("ResearchThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  gallery     Media[] @relation("ResearchGallery")

  revisions Revision[]
}

model Experience {
  id             String    @id @default(cuid())
  company        String
  role           String
  startDate      DateTime
  endDate        DateTime?
  location       String?
  descriptionMDX String
  highlights     String
  thumbnailId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  thumbnail Media? @relation("ExperienceThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
}

model Activity {
  id             String       @id @default(cuid())
  title          String
  type           String
  date           DateTime
  descriptionMDX String
  links          String
  thumbnailId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  thumbnail Media? @relation("ActivityThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  width     Int?
  height    Int?
  size      Int?
  altText   String?
  caption   String?
  createdAt DateTime @default(now())

  uploadedBy   User?   @relation("Uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  // Relations for thumbnails
  projectThumbnails    Project[]    @relation("ProjectThumbnail")
  researchThumbnails   Research[]   @relation("ResearchThumbnail")
  experienceThumbnails Experience[] @relation("ExperienceThumbnail")
  activityThumbnails   Activity[]   @relation("ActivityThumbnail")

  // Relations for galleries
  projectGallery    Project?  @relation("ProjectGallery", fields: [projectGalleryId], references: [id], onDelete: Cascade)
  projectGalleryId  String?
  researchGallery   Research? @relation("ResearchGallery", fields: [researchGalleryId], references: [id], onDelete: Cascade)
  researchGalleryId String?
}

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  category String?
}

model Revision {
  id         String         @id @default(cuid())
  entityType String
  entityId   String
  snapshot   String
  action     String         @default("SAVE")
  createdAt  DateTime       @default(now())

  author     User      @relation("RevisionAuthor", fields: [authorId], references: [id])
  authorId   String
  Project    Project?  @relation(fields: [projectId], references: [id])
  projectId  String?
  Research   Research? @relation(fields: [researchId], references: [id])
  researchId String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
